#!/bin/sh
# Installed by cargo-husky (user-hooks). Mirrors the fmt/clippy steps from
# .github/workflows/ci.yml so bad formatting or lint errors
# never leave the local machine.
set -e

echo '+cargo fmt --all -- --check'
cargo fmt --all -- --check

# TEMPORARY (roadmap P1.6 to P1.8): the new lints of [workspace.lints] are `warn` until the code
# is clean, so warnings are allowed here. `deny` lints still fail. P1.8 restores `-D warnings`.
echo '+cargo clippy -p next_tablet_driver --all-targets --all-features'
cargo clippy -p next_tablet_driver --all-targets --all-features
