#!/bin/sh
# Installed by cargo-husky (user-hooks). Runs the full CI gate from
# .github/workflows/ci.yml before code leaves this machine.
set -e

if ! cargo nextest --version >/dev/null 2>&1; then
  echo 'cargo-nextest is required to run the tests: cargo install --locked cargo-nextest' >&2
  exit 1
fi

echo '+cargo fmt --all -- --check'
cargo fmt --all -- --check

# TEMPORARY (roadmap P1.6 to P1.8): the new lints of [workspace.lints] are `warn` until the code
# is clean, so warnings are allowed here. `deny` lints still fail. P1.8 restores `-D warnings`.
echo '+cargo clippy -p next_tablet_driver --all-targets --all-features'
cargo clippy -p next_tablet_driver --all-targets --all-features

echo '+cargo nextest run -p next_tablet_driver --all-features'
cargo nextest run -p next_tablet_driver --all-features

# nextest does not run doctests.
echo '+cargo test -p next_tablet_driver --all-features --doc'
cargo test -p next_tablet_driver --all-features --doc
