  "steps": [
    {
      "id": "out-of-range",
      "instruction": "Keep the pen away from the tablet. Do not touch anything.",
      "start_ms": 15643,
      "end_ms": 18644
    },
    {
      "id": "hover",
      "instruction": "Hold the pen just above the tablet, without touching it. Keep it still.",
      "start_ms": 23893,
      "end_ms": 28893
    },
    {
      "id": "hover-move",
      "instruction": "Move the pen slowly above the tablet, without touching it.",
      "start_ms": 31957,
      "end_ms": 36957
    },
    {
      "id": "touch-light",
      "instruction": "Draw slowly on the tablet with a very light pressure.",
      "start_ms": 44127,
      "end_ms": 49127
    },
    {
      "id": "touch-hard",
      "instruction": "Draw slowly on the tablet with a hard pressure.",
      "start_ms": 52613,
      "end_ms": 57614
    },
    {
      "id": "tilt",
      "instruction": "Draw while tilting the pen in every direction.",
      "start_ms": 61684,
      "end_ms": 66684
    },
    {
      "id": "pen-button-1",
      "instruction": "Hover over the tablet and press the first pen button several times.",
      "start_ms": 70967,
      "end_ms": 75967
    },
    {
      "id": "pen-button-2",
      "instruction": "Hover over the tablet and press the second pen button several times.",
      "start_ms": 77725,
      "end_ms": 82725
    },
    {
      "id": "tablet-buttons",
      "instruction": "Press every button of the tablet, one after the other.",
      "start_ms": 85553,
      "end_ms": 95554
    },
    {
      "id": "corners",
      "instruction": "Touch each of the four corners, then the center, one at a time.",
      "start_ms": 103049,
      "end_ms": 113049
    }
  ],
