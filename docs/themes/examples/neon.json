{
  "$schema": "https://raw.githubusercontent.com/Next-Tablet-Driver/NextTabletDriver/master/docs/themes/theme.schema.json",
  "schema": 1,
  "metadata": {
    "name": "Neon",
    "author": "iSweat",
    "version": "1.0",
    "description": "Near-black with a hot pink accent. Converted from the original egui theme format."
  },
  "base": "dark",
  "tokens": {
    "bg-app": "#0a0a0f",
    "bg-panel": "#12121c",
    "bg-panel-hover": "#2a2a3f",
    "bg-input": "#1c1c2a",

    "text-main": "#bcbcd0",
    "text-muted": "#8a8aa3",
    "text-active": "#ffffff",
    "text-strong": "#e6e6f5",
    "text-emphasis": "#ffffff",
    "text-on-accent": "#ffffff",
    "text-number": "#1e90ff",

    "accent": "#ff007f",
    "accent-hover": "#ff3399",

    "border": "#232333",

    "info": "#1e90ff",
    "warning": "#ffa502",
    "error": "#ff4757",
    "danger": "#ff4757",
    "danger-hover": "#ff6b81",
    "success": "#2ed573",
    "debug": "#8a8aa3",

    "overlay-rgb": "255 255 255",
    "shade-rgb": "0 0 0",

    "input-bg": "#1c1c2a",
    "input-bg-hover": "#2a2a3f",
    "input-bg-focus": "#2a2a3f",
    "input-border": "#232333",
    "input-border-hover": "#34344d",

    "area-playfield": "rgba(255, 255, 255, 0.25)",
    "area-border-pink": "#ffffff",

    "console-text": "#bcbcd0",

    "radius-sm": "4px",
    "radius-md": "4px",
    "radius-lg": "4px",
    "radius-xl": "4px"
  }
}
