{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NextTabletDriver",
  "version": "3.0.0",
  "identifier": "com.nexttabletdriver.app",
  "build": {
    "frontendDist": "../../frontend-react/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix ./frontend-react",
    "beforeBuildCommand": "npm run build --prefix ./frontend-react"
  },
  "app": {
    "windows": [
      {
        "title": "NextTabletDriver",
        "width": 1000,
        "height": 900,
        "minWidth": 420,
        "minHeight": 240,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://github.com https://avatars.githubusercontent.com; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Low-latency tablet driver for osu! and drawing",
    "longDescription": "NextTabletDriver is a low-latency tablet driver for osu! and drawing, with precise mapping controls and a plugin system.",
    "publisher": "iSweat",
    "license": "MIT AND LGPL-3.0-only",
    "resources": {
      "../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../../licenses/OpenTabletDriver-LGPL-3.0.txt": "licenses/OpenTabletDriver-LGPL-3.0.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/99-nexttabletdriver.rules": "../../scripts/99-nexttabletdriver.rules"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Next-Tablet-Driver/NextTabletDriver/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGQ0YzRjhENkZCREZBNjkKUldScCtyMXZqVC9Qbi9LR3J1VFR5eStsSTUzN2ZmVy9hTEljRXE0YlZkNXpQcTBsdzZleE82eUQK",
      "dangerousInsecureTransportProtocol": false
    }
  }
}
