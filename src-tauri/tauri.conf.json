{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NextTabletDriver",
  "version": "2.0.0",
  "identifier": "com.nexttabletdriver.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix ./frontend",
    "beforeBuildCommand": "npm run build --prefix ./frontend"
  },
  "app": {
    "windows": [
      {
        "title": "NextTabletDriver",
        "width": 1000,
        "height": 900,
        "minWidth": 420,
        "minHeight": 240,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://github.com https://avatars.githubusercontent.com; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Low-latency tablet driver for osu! and drawing",
    "longDescription": "NextTabletDriver is a low-latency tablet driver for osu! and drawing, with precise mapping controls and a plugin system.",
    "publisher": "iSweat",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/99-nexttabletdriver.rules": "../scripts/99-nexttabletdriver.rules"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Next-Tablet-Driver/NextTabletDriver/releases/latest/download/latest.json"
      ],
      "pubkey": "dW51c2VkX3B1YmtleV9mb3JfZGV2ZWxvcG1lbnRfcHVycG9zZXM=",
      "dangerousInsecureTransportProtocol": false
    }
  }
}
