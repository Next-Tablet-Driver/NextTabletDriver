  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p e2e/tsconfig.json && tsc -p e2e-native/tsconfig.json",
    "test": "vitest",
